---
import { Picture } from 'astro:assets';
import Figura from './Figura.astro';
import type { Rua } from '../data/rua';

interface Props {
	data: Rua;
}

const { data } = Astro.props;
const capa = data.renders[0];
---

<article>
	<section class="abertura">
		<Picture
			src={capa.imagem}
			alt={capa.legenda}
			widths={[640, 1024, 1536, 1920]}
			sizes="100vw"
			formats={['avif', 'webp']}
			class="abertura__fundo"
			loading="eager"
		/>
		<div class="abertura__conteudo">
			<p class="abertura__subtitulo legenda">{data.subtitulo}</p>
			<h1 class="abertura__titulo">{data.titulo}</h1>
			<p class="abertura__frase">{data.fraseDeAbertura}</p>
		</div>
	</section>

	<section class="secao secao--texto">
		<h2 class="legenda">Conceito</h2>
		<p class="texto-editorial">{data.conceito}</p>
	</section>

	<section class="secao secao--texto">
		<h2 class="legenda">Partido</h2>
		<p class="texto-editorial">{data.partido}</p>
	</section>

	<section class="secao secao--programa">
		<h2 class="legenda">Programa</h2>
		<dl class="programa">
			{
				data.programa.map((item) => (
					<div class="programa__item">
						<dt class="legenda">{item.pavimento}</dt>
						<dd>{item.uso}</dd>
					</div>
				))
			}
		</dl>
	</section>

	<section class="secao secao--galeria secao--escura">
		<h2 class="legenda">Renders</h2>
		<div class="galeria-assimetrica">
			{data.renders.slice(1).map((r) => <Figura imagem={r.imagem} legenda={r.legenda} />)}
		</div>
	</section>

	<section class="secao secao--galeria">
		<h2 class="legenda">Modelo 3D</h2>
		<div class="galeria-assimetrica">
			{data.capturas.map((c) => <Figura imagem={c.imagem} legenda={c.legenda} />)}
		</div>
	</section>

	<section class="secao secao--pranchas">
		<h2 class="legenda">Pranchas técnicas</h2>
		<div class="pranchas">
			{data.pranchas.map((p) => <Figura imagem={p.imagem} legenda={p.legenda} widths={[640, 1024, 1600, 2200]} />)}
		</div>
	</section>

	<footer class="rodape secao--escura">
		<dl class="metadados">
			<div><dt class="legenda">Ano</dt><dd>{data.metadados.ano}</dd></div>
			<div><dt class="legenda">Disciplina</dt><dd>{data.metadados.disciplina}</dd></div>
			<div><dt class="legenda">Instituição</dt><dd>{data.metadados.instituicao}</dd></div>
			<div><dt class="legenda">Orientação</dt><dd>{data.metadados.orientacao}</dd></div>
			<div><dt class="legenda">Autoria</dt><dd>{data.metadados.autoria}</dd></div>
			<div><dt class="legenda">Localização</dt><dd>{data.metadados.localizacao}</dd></div>
			<div><dt class="legenda">Área do terreno</dt><dd>{data.metadados.areaDoTerreno}</dd></div>
		</dl>
		<div class="rodape__cta">
			<a class="cta" href={data.pdfUrl}>Baixar apresentação em PDF</a>
			<a class="cta" href="/sobre">Falar com a autora</a>
		</div>
	</footer>
</article>

<style>
	.abertura {
		position: relative;
		width: 100%;
		aspect-ratio: 3 / 2;
		background: var(--ink);
	}

	.abertura :global(.abertura__fundo) {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.abertura__conteudo {
		position: absolute;
		left: clamp(1.5rem, 6vw, 4rem);
		bottom: clamp(1.5rem, 6vw, 3rem);
		max-width: 34rem;
		color: var(--paper);
	}

	.abertura__subtitulo {
		color: var(--ash);
		margin: 0 0 0.5rem;
	}

	.abertura__titulo {
		font-size: clamp(2rem, 6vw, 4rem);
		color: var(--paper);
	}

	.abertura__frase {
		margin: 1rem 0 0;
		font-family: var(--font-display);
		text-transform: uppercase;
		letter-spacing: 0.1em;
		font-size: clamp(1rem, 2.2vw, 1.5rem);
		color: var(--sand);
	}

	.secao {
		padding: clamp(2.5rem, 8vw, 6rem) clamp(1.5rem, 6vw, 4rem);
		background: var(--paper);
	}

	.secao--escura {
		background: var(--ink);
		color: var(--paper);
	}

	.secao--escura .legenda {
		color: var(--ash);
	}

	.secao--texto {
		max-width: 42rem;
	}

	.secao--texto h2 {
		margin-bottom: 1rem;
	}

	.texto-editorial {
		max-width: 65ch;
		line-height: 1.7;
		margin: 0;
	}

	.secao--programa h2 {
		margin-bottom: 1.5rem;
	}

	.programa {
		margin: 0;
		max-width: 40rem;
		border-top: 1px solid var(--ash);
	}

	.programa__item {
		display: grid;
		grid-template-columns: 1fr 2fr;
		gap: 1.5rem;
		padding: 1rem 0;
		border-bottom: 1px solid var(--ash);
	}

	.programa__item dt {
		margin: 0;
	}

	.programa__item dd {
		margin: 0;
		color: var(--graphite);
	}

	.secao--galeria h2 {
		margin-bottom: 1.5rem;
	}

	.galeria-assimetrica {
		display: grid;
		grid-template-columns: repeat(12, 1fr);
		gap: clamp(0.75rem, 2vw, 1.5rem);
	}

	.galeria-assimetrica > :global(*:nth-child(9n + 1)) {
		grid-column: span 7;
	}
	.galeria-assimetrica > :global(*:nth-child(9n + 2)) {
		grid-column: span 5;
	}
	.galeria-assimetrica > :global(*:nth-child(9n + 3)) {
		grid-column: span 12;
	}
	.galeria-assimetrica > :global(*:nth-child(9n + 4)) {
		grid-column: span 5;
	}
	.galeria-assimetrica > :global(*:nth-child(9n + 5)) {
		grid-column: span 7;
	}
	.galeria-assimetrica > :global(*:nth-child(9n + 6)) {
		grid-column: span 8;
	}
	.galeria-assimetrica > :global(*:nth-child(9n + 7)) {
		grid-column: span 4;
	}
	.galeria-assimetrica > :global(*:nth-child(9n + 8)) {
		grid-column: span 4;
	}
	.galeria-assimetrica > :global(*:nth-child(9n + 9)) {
		grid-column: span 8;
	}

	.secao--pranchas h2 {
		margin-bottom: 1.5rem;
	}

	.pranchas {
		display: grid;
		gap: clamp(1.5rem, 4vw, 3rem);
	}

	.rodape {
		padding: clamp(2.5rem, 8vw, 6rem) clamp(1.5rem, 6vw, 4rem);
		display: flex;
		flex-wrap: wrap;
		gap: clamp(2rem, 6vw, 5rem);
		justify-content: space-between;
	}

	.metadados {
		display: grid;
		gap: 1rem;
		margin: 0;
		min-width: 16rem;
	}

	.metadados dt {
		margin: 0 0 0.15rem;
	}

	.metadados dd {
		margin: 0;
		color: var(--sand);
	}

	.rodape__cta {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		align-self: flex-start;
	}

	.cta {
		color: var(--navy);
		background: var(--paper);
		display: inline-block;
		width: fit-content;
		padding: 0.75rem 1.5rem;
		font-family: var(--font-display);
		text-transform: uppercase;
		letter-spacing: 0.14em;
		font-size: 0.8rem;
		text-decoration: underline;
		text-underline-offset: 0.25em;
		text-decoration-thickness: 1px;
	}

	.cta:hover,
	.cta:focus-visible {
		text-decoration-thickness: 2px;
	}

	@media (max-width: 640px) {
		.galeria-assimetrica > :global(*) {
			grid-column: span 12 !important;
		}
	}
</style>
