---
import { Picture } from 'astro:assets';
import heroPlanta from '../assets/hero-planta.png';
---

<div class="hero">
	<Picture
		src={heroPlanta}
		alt=""
		widths={[640, 960, 1280, 1536]}
		sizes="100vw"
		formats={['avif', 'webp']}
		class="hero__bg"
	/>
	<h1 class="hero__titulo" aria-label="Ana Myrna Matos — Portfólio">
		<span aria-hidden="true">POR</span>
		<span aria-hidden="true">TFÓ</span>
		<span aria-hidden="true">LIO</span>
	</h1>
</div>

<style>
	.hero {
		position: relative;
		width: 100%;
		aspect-ratio: 1536 / 1024;
		background: var(--paper);
	}

	.hero :global(.hero__bg) {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.hero__titulo {
		position: absolute;
		left: 29%;
		top: 34%;
		width: 32%;
		font-family: var(--font-display);
		font-weight: 500;
		line-height: 0.92;
		color: var(--graphite);
		font-size: clamp(1.6rem, 5vw, 4rem);
		letter-spacing: 0.05em;
	}

	.hero__titulo span {
		display: block;
	}
</style>
