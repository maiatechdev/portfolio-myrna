---
import Layout from '../../layouts/Layout.astro';
import ProjetoCompleto from '../../components/ProjetoCompleto.astro';
import { rua } from '../../data/rua';

// PLACEHOLDER: os slugs virão de uma query ao Sanity (caseCompleto + estudoCurto).
// Layout da página varia por tipo de conteúdo — a decidir quando os schemas existirem.
export function getStaticPaths() {
	return [
		{ params: { slug: 'centro-cultural-rua' } },
		{ params: { slug: 'capilla-de-las-sombras' } },
		{ params: { slug: 'limiar' } },
		{ params: { slug: 'cozinha-safira' } },
	];
}

const { slug } = Astro.params;
const ehRua = slug === rua.slug;
---

<Layout title={ehRua ? `${rua.titulo} — Ana Myrna Matos` : `${slug} — Ana Myrna Matos`}>
	<main>
		{
			ehRua ? (
				<ProjetoCompleto data={rua} />
			) : (
				<p>
					{/* PLACEHOLDER: estudoCurto (Capilla de las Sombras, Limiar, Cozinha Safira) aguardando conteúdo da cliente. */}
				</p>
			)
		}
	</main>
</Layout>
